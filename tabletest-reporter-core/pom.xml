<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.tabletest</groupId>
        <artifactId>tabletest-reporter</artifactId>
        <version>1.3.1-SNAPSHOT</version>
    </parent>

    <artifactId>tabletest-reporter-core</artifactId>
    <packaging>jar</packaging>

    <name>TableTest Reporter Core</name>

    <properties>
        <version.tabletest-junit>1.2.2</version.tabletest-junit>
        <version.tabletest-parser>1.2.1</version.tabletest-parser>
        <version.snakeyaml>3.0.1</version.snakeyaml>
        <version.pebble>4.1.2</version.pebble>
        <version.logback>1.5.38</version.logback>

        <version.junit>6.1.2</version.junit>
        <version.assertj>3.27.7</version.assertj>
        <version.commonmark>0.29.0</version.commonmark>
        <version.asciidoctorj>3.0.1</version.asciidoctorj>
        <version.jsoup>1.22.2</version.jsoup>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.tabletest</groupId>
            <artifactId>tabletest-parser</artifactId>
            <version>${version.tabletest-parser}</version>
        </dependency>
        <dependency>
            <groupId>org.snakeyaml</groupId>
            <artifactId>snakeyaml-engine</artifactId>
            <version>${version.snakeyaml}</version>
        </dependency>
        <dependency>
            <groupId>io.pebbletemplates</groupId>
            <artifactId>pebble</artifactId>
            <version>${version.pebble}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${version.logback}</version>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.tabletest</groupId>
            <artifactId>tabletest-junit</artifactId>
            <version>${version.tabletest-junit}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.tabletest</groupId>
            <artifactId>tabletest-reporter-junit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${version.junit}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-testkit</artifactId>
            <version>${version.junit}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${version.assertj}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>${version.commonmark}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.asciidoctor</groupId>
            <artifactId>asciidoctorj</artifactId>
            <version>${version.asciidoctorj}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${version.jsoup}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Living documentation, self-hosted: every @TableTest publishes by default; the
             internal-mechanism tables the spec should not show are held back at report time by
             the publish/exclude section of tabletest-reporter.yaml (no test tags, no group
             filter). Renders the HTML report with this build's own reporter extension and maven
             plugin. Must run as a single-project build (the plugin reference would be a reactor
             cycle). After `mvn install -DskipTests` at the root:
             `mvn -f tabletest-reporter-core -Preport test org.tabletest:tabletest-reporter-maven-plugin:report` -->
        <profile>
            <id>report</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <properties>
                                <configurationParameters>
                                    junit.jupiter.extensions.autodetection.enabled=true
                                </configurationParameters>
                            </properties>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.tabletest</groupId>
                        <artifactId>tabletest-reporter-maven-plugin</artifactId>
                        <version>${project.version}</version>
                        <configuration>
                            <format>html</format>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>