{% import "macros.html.peb" %}
{% set hasResults = rowResults is not empty %}
{% set total = 0 %}
{% set passedCount = 0 %}
{% for result in rowResults %}{% set total = total + 1 %}{% if result.passed %}{% set passedCount = passedCount + 1 %}{% endif %}{% endfor %}
{% set brokenCount = total - passedCount %}
{% set hasFailures = brokenCount > 0 %}
{% set firstIsScenario = headers is not empty and headers[0].roles is not empty and headers[0].roles contains 'scenario' %}
<!DOCTYPE html>
<html lang="en">
<head>
{{ head(title) }}
</head>
<body>
{{ renderSidebar(nav, assetRoot) }}
<main>
    {{ renderBreadcrumbs(breadcrumbs) }}
    <header class="masthead">
        <div class="masthead-top">
            <div class="masthead-left">
                {{ navToggle(nav) }}
                <p class="eyebrow">Specification</p>
            </div>
            {{ themeToggle() }}
        </div>
        <h1>{{ title | escape }}</h1>
        {%- if hasResults -%}
            {%- if hasFailures -%}
                <p class="verdict fail"><span class="count">{{ brokenCount }}</span> of {{ total }} scenario{{ total == 1 ? '' : 's' }} broken</p>
            {%- else -%}
                <p class="verdict pass">All <span class="count">{{ total }}</span> scenario{{ total == 1 ? '' : 's' }} hold</p>
            {%- endif -%}
        {%- endif -%}
        {% if description %}<p class="description">{{ description | escape }}</p>{% endif %}
    </header>

    <div class="controls">
        <input type="search" id="row-filter" placeholder="filter rows&hellip;" aria-label="Filter rows">
        {%- if hasFailures -%}
            <label class="toggle"><input type="checkbox" id="failing-only"> Failing only</label>
        {%- endif -%}
        <span class="legend">
            <span><span class="chip expectation"></span> expected outcome</span>
            <span><span class="chip fail"></span> broken scenario</span>
        </span>
    </div>

    <div class="table-wrap">
        <table{{ firstIsScenario ? ' class="anchored"' : '' }}>
            <thead>
                <tr>
                {%- for header in headers -%}
                    <th class="cell{{ roleClasses(header) }}">{{ renderValue(header.value) }}</th>
                {%- endfor -%}
                </tr>
            </thead>
            <tbody>
            {%- for row in rows -%}
                {%- set rowFailed = false -%}
                {%- for cell in row -%}{%- if cell.roles is not empty and cell.roles contains 'failed' -%}{%- set rowFailed = true -%}{%- endif -%}{%- endfor -%}
                <tr class="{{ rowFailed ? 'failed-row' : '' }}" data-failed="{{ rowFailed ? 'true' : 'false' }}">
                {%- for cell in row -%}
                    <td class="cell{{ roleClasses(cell) }}">{{ renderValue(cell.value) }}</td>
                {%- endfor -%}
                </tr>
            {%- endfor -%}
            </tbody>
        </table>
    </div>

    {% if hasFailures %}
    <section class="failures">
        <h2>Broken scenarios</h2>
        {%- for result in rowResults -%}
            {%- if not result.passed -%}
                <details open>
                    <summary>{{ result.displayName | escape }}</summary>
                    <pre>{{ result.errorMessage | escape }}</pre>
                </details>
            {%- endif -%}
        {%- endfor -%}
    </section>
    {% endif %}

    <footer class="doc-footer">Generated by tabletest-reporter</footer>
</main>
{{ themeScript() }}
{{ navScript() }}
<script src="{{ assetRoot }}tabletest-search-index.js"></script>
{{ searchScript() }}
<script>
(function () {
    var filter = document.getElementById("row-filter");
    var failingOnly = document.getElementById("failing-only");
    var rows = Array.prototype.slice.call(document.querySelectorAll("tbody tr"));
    function apply() {
        var needle = (filter ? filter.value : "").toLowerCase();
        var onlyFailing = failingOnly && failingOnly.checked;
        rows.forEach(function (row) {
            var matchesText = row.textContent.toLowerCase().indexOf(needle) !== -1;
            var matchesFailing = !onlyFailing || row.getAttribute("data-failed") === "true";
            row.classList.toggle("hidden", !(matchesText && matchesFailing));
        });
    }
    if (filter) filter.addEventListener("input", apply);
    if (failingOnly) failingOnly.addEventListener("change", apply);
})();
</script>
</body>
</html>
