{% import "macros.html.peb" %}
<!DOCTYPE html>
<html lang="en">
<head>
{{ head(title) }}
{# Style a column role of your own here; the built-in stylesheet above stays in place. #}
<style>{% block extra_stylesheet %}{% endblock %}</style>
</head>
<body>
{{ renderSidebar(nav, assetRoot) }}
<main>
    <header class="masthead" id="top">
        {{ mastheadBar(null, nav, "Specification report") }}
        <h1>{{ title | escape }}</h1>
        {% for paragraph in description | paragraphs %}<p class="description">{{ paragraph | escape }}</p>{% endfor %}
    </header>

    {%- for section in sections -%}
    <section id="{{ section.anchor }}" class="report-section {{ section.type }} {{ section.status }}">
        <h{{ section.level }} class="section-title">{{ section.title | escape }}</h{{ section.level }}>
        {%- if section.type == 'table' -%}
            {{ tableVerdict(section.rowResults) }}
            {% for paragraph in section.description | paragraphs %}<p class="description">{{ paragraph | escape }}</p>{% endfor %}
            {{ tableGrid(section.headers, section.rows) }}
            {{ tableFailures(section.rowResults, section.level < 6 ? section.level + 1 : 6) }}
        {%- else -%}
            {% for paragraph in section.description | paragraphs %}<p class="description">{{ paragraph | escape }}</p>{% endfor %}
        {%- endif -%}
    </section>
    {%- endfor -%}

    {{ docFooter(generatedAt) }}
</main>
{{ themeScript() }}
{{ tableScrollScript() }}
{{ navScript() }}
<script>{{ searchData }}</script>
{{ searchScript() }}
</body>
</html>
