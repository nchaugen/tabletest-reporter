{% import "macros.html.peb" %}
<!DOCTYPE html>
<html lang="en">
<head>
{{ head(title) }}
</head>
<body>
{{ renderSidebar(nav, assetRoot) }}
<main>
    <header class="masthead" id="top">
        <div class="masthead-top">
            <div class="masthead-left">
                {{ navToggle(nav) }}
                <p class="eyebrow">Specification report</p>
            </div>
            {{ themeToggle() }}
        </div>
        <h1>{{ title | escape }}</h1>
        {% if description %}<p class="description">{{ description | escape }}</p>{% endif %}
    </header>

    {%- for section in sections -%}
    <section id="{{ section.anchor }}" class="report-section {{ section.type }} {{ section.status }}">
        <h{{ section.level }} class="section-title">{{ section.title | escape }}</h{{ section.level }}>
        {%- if section.type == 'table' -%}
            {{ tableVerdict(section.rowResults) }}
            {% if section.description %}<p class="description">{{ section.description | escape }}</p>{% endif %}
            {{ tableGrid(section.headers, section.rows) }}
            {{ tableFailures(section.rowResults) }}
        {%- else -%}
            {% if section.description %}<p class="description">{{ section.description | escape }}</p>{% endif %}
        {%- endif -%}
    </section>
    {%- endfor -%}

    <footer class="doc-footer">Generated by tabletest-reporter</footer>
</main>
{{ themeScript() }}
{{ navScript() }}
<script>{{ searchData }}</script>
{{ searchScript() }}
</body>
</html>
