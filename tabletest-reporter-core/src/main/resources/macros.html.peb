{# Shared macros for the self-contained HTML report format. #}

{# ----- Collection / value rendering (ported from macros.adoc.peb) ----- #}
{# HTML nesting carries depth structurally, so the AsciiDoc bullet/indent/    #}
{# encoding machinery is dropped; set vs list vs map survive as CSS classes.  #}

{% macro renderValue(value) %}
    {%- if value is null -%}
    {%- elseif value is set -%}
        {{- renderList(value, 'set') -}}
    {%- elseif value is iterable -%}
        {{- renderList(value, 'list') -}}
    {%- elseif value is map -%}
        {{- renderMap(value) -}}
    {%- else -%}
        {{- renderLiteral(value) -}}
    {%- endif -%}
{% endmacro %}

{% macro renderList(items, kind) %}
    {%- if items is empty -%}
        <span class="empty">{{ kind == 'set' ? '{}' : '[]' }}</span>
    {%- else -%}
        <ul class="coll {{ kind }}">
        {%- for value in items -%}
            <li>{{ renderValue(value) }}</li>
        {%- endfor -%}
        </ul>
    {%- endif -%}
{% endmacro %}

{% macro renderMap(map) %}
    {%- if map is empty -%}
        <span class="empty">[:]</span>
    {%- else -%}
        <dl class="coll map">
        {%- for entry in map -%}
            <dt>{{ entry.key | escape }}</dt><dd>{{ renderValue(entry.value) }}</dd>
        {%- endfor -%}
        </dl>
    {%- endif -%}
{% endmacro %}

{% macro renderLiteral(value) %}
    {%- if value == '' -%}
        <span class="literal empty-string">&#8220;&#8221;</span>
    {%- elseif value is whitespaceSignificant -%}
        <span class="literal ws">{{ value | markWhitespace }}</span>
    {%- else -%}
        <span class="literal">{{ value | escape }}</span>
    {%- endif -%}
{% endmacro %}

{% macro roleClasses(cell) %}
    {%- if cell.roles is not empty %} {{ cell.roles | join(' ') }}{% endif -%}
{% endmacro %}

{# ----- Table content, shared by the per-page shell and the single-file assembly ----- #}
{# These render only the table's own content (verdict, grid, failures); page chrome     #}
{# (masthead, per-page filter, nav) stays in whichever shell embeds them.                #}

{% macro tableVerdict(rowResults) %}
    {%- if rowResults is not empty -%}
        {%- set total = 0 -%}
        {%- set passedCount = 0 -%}
        {%- for result in rowResults -%}{%- set total = total + 1 -%}{%- if result.passed -%}{%- set passedCount = passedCount + 1 -%}{%- endif -%}{%- endfor -%}
        {%- set brokenCount = total - passedCount -%}
        {%- if brokenCount > 0 -%}
            <p class="verdict fail"><span class="count">{{ brokenCount }}</span> of {{ total }} scenario{{ total == 1 ? '' : 's' }} broken</p>
        {%- else -%}
            <p class="verdict pass">All <span class="count">{{ total }}</span> scenario{{ total == 1 ? '' : 's' }} hold</p>
        {%- endif -%}
    {%- endif -%}
{% endmacro %}

{% macro tableGrid(headers, rows) %}
    {%- set firstIsScenario = headers is not empty and headers[0].roles is not empty and headers[0].roles contains 'scenario' -%}
    <div class="table-wrap">
        <table{{ firstIsScenario ? ' class="anchored"' : '' }}>
            <thead>
                <tr>
                {%- for header in headers -%}
                    <th class="cell{{ roleClasses(header) }}">{{ renderValue(header.value) }}</th>
                {%- endfor -%}
                </tr>
            </thead>
            <tbody>
            {%- for row in rows -%}
                {%- set rowFailed = false -%}
                {%- for cell in row -%}{%- if cell.roles is not empty and cell.roles contains 'failed' -%}{%- set rowFailed = true -%}{%- endif -%}{%- endfor -%}
                <tr class="{{ rowFailed ? 'failed-row' : '' }}" data-failed="{{ rowFailed ? 'true' : 'false' }}">
                {%- for cell in row -%}
                    <td class="cell{{ roleClasses(cell) }}">{{ renderValue(cell.value) }}</td>
                {%- endfor -%}
                </tr>
            {%- endfor -%}
            </tbody>
        </table>
    </div>
{% endmacro %}

{# headingLevel keeps "Broken scenarios" one step below the enclosing title so the document #}
{# outline stays monotonic: h2 under a per-page h1, or level+1 under a single-file section.  #}
{% macro tableFailures(rowResults, headingLevel) %}
    {%- set hasFailures = false -%}
    {%- for result in rowResults -%}{%- if not result.passed -%}{%- set hasFailures = true -%}{%- endif -%}{%- endfor -%}
    {%- if hasFailures -%}
    <section class="failures">
        <h{{ headingLevel }}>Broken scenarios</h{{ headingLevel }}>
        {%- for result in rowResults -%}
            {%- if not result.passed -%}
                <details open>
                    <summary>{{ result.displayName | escape }}</summary>
                    <pre>{{ result.errorMessage | escape }}</pre>
                </details>
            {%- endif -%}
        {%- endfor -%}
    </section>
    {%- endif -%}
{% endmacro %}

{# ----- Index link-tree recursion (ported from macros.adoc.peb) ----- #}

{% macro renderIndexItem(item) %}
    <li class="nav-item {{ item.type }} {{ item.status }}">
        <a href="./{{ item.path }}{{ item.type == 'index' ? '/index.html' : '.html' }}"><span class="status-dot" aria-hidden="true"></span>{{ (item.title ? item.title : item.name) | escape }}</a>
        {%- if item.contents is not empty -%}
            <ul class="nav-children">
            {%- for nested in item.contents -%}
                {{ renderIndexItem(nested) }}
            {%- endfor -%}
            </ul>
        {%- endif -%}
    </li>
{% endmacro %}

{# ----- Breadcrumb trail: ancestor chain from the root to the current page ----- #}

{% macro renderBreadcrumbs(crumbs) %}
    {%- if crumbs is not empty and crumbs | length > 1 -%}
    <nav class="breadcrumbs bar-mid" aria-label="Breadcrumb">
        <ol>
        {%- for crumb in crumbs -%}
            <li>
            {%- if crumb.current -%}
                <span aria-current="page">{{ crumb.label | escape }}</span>
            {%- else -%}
                <a href="{{ crumb.href }}">{{ crumb.label | escape }}</a>
            {%- endif -%}
            </li>
        {%- endfor -%}
        </ol>
    </nav>
    {%- endif -%}
{% endmacro %}

{# ----- One-line masthead bar: menu | (breadcrumb or eyebrow) | theme ----- #}
{# The middle slot carries the breadcrumb trail on nested pages and falls back  #}
{# to the page-type eyebrow on depth-1 pages (root index, single-file report),  #}
{# so it is never empty and never duplicates the trail. The menu button stays   #}
{# far left because the drawer it opens slides in from the left.                #}

{% macro mastheadBar(breadcrumbs, nav, eyebrow) %}
    <div class="masthead-top">
        {{ navToggle(nav) }}
        {%- if breadcrumbs is not empty and breadcrumbs | length > 1 -%}
            {{ renderBreadcrumbs(breadcrumbs) }}
        {%- else -%}
            <p class="eyebrow bar-mid">{{ eyebrow | escape }}</p>
        {%- endif -%}
        {{ themeToggle() }}
    </div>
{% endmacro %}

{# ----- Page footer: who generated the report, and when ----- #}
{# The run timestamp is what tells a reader whether the spec still tracks the code, #}
{# so it carries a machine-readable <time datetime> alongside the readable label.   #}
{# A context without a timestamp (custom renderers) still gets the attribution.     #}

{% macro docFooter(generatedAt) %}
    <footer class="doc-footer">Generated by tabletest-reporter{% if generatedAt is not null %} &middot; <time datetime="{{ generatedAt.datetime }}">{{ generatedAt.label }}</time>{% endif %}</footer>
{% endmacro %}

{# ----- Persistent sidebar: the whole-tree nav, present on every page ----- #}

{% macro navToggle(nav) %}
    {%- if nav is not empty -%}
    <button type="button" id="nav-toggle" class="nav-toggle" aria-label="Open navigation"
        aria-controls="site-nav" aria-expanded="false">&#9776;</button>
    {%- endif -%}
{% endmacro %}

{% macro renderSidebar(nav, assetRoot) %}
    {%- if nav is not empty -%}
    <div class="nav-backdrop"></div>
    <aside id="site-nav" class="sidebar" aria-label="Report navigation">
        <a class="sidebar-home{{ nav.home.current ? ' current' : '' }}" href="{{ nav.home.href }}"
            {{- nav.home.current ? ' aria-current="page"' : '' }}>{{ nav.home.label | escape }}</a>
        <div class="sidebar-search">
            <input type="search" id="report-search" placeholder="search all specifications&hellip;"
                aria-label="Search all specifications" data-asset-root="{{ assetRoot }}">
        </div>
        <ul id="search-results" class="search-results hidden" aria-label="Search results"></ul>
        <nav class="site-nav" aria-label="All specifications">
            <ul class="nav-tree">
            {%- for item in nav.tree -%}
                {{ renderNavItem(item) }}
            {%- endfor -%}
            </ul>
        </nav>
    </aside>
    {%- endif -%}
{% endmacro %}

{% macro navScript() %}
<script>
(function () {
    var toggle = document.getElementById("nav-toggle");
    var drawer = document.getElementById("site-nav");
    var backdrop = document.querySelector(".nav-backdrop");
    if (!toggle || !drawer) return;
    function setOpen(open) {
        drawer.classList.toggle("open", open);
        if (backdrop) backdrop.classList.toggle("open", open);
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
    }
    toggle.addEventListener("click", function () { setOpen(!drawer.classList.contains("open")); });
    if (backdrop) backdrop.addEventListener("click", function () { setOpen(false); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") setOpen(false); });
})();
</script>
{% endmacro %}

{# ----- Whole-report search over the shared index asset ----- #}
{# The index is loaded once per page from the output root (assetRoot-relative <script src>). #}
{# Each result's path is root-relative; the page's own assetRoot resolves it at click time.   #}

{% macro searchScript() %}
<script>
(function () {
    var index = window.TableTestSearchIndex || [];
    var input = document.getElementById("report-search");
    var results = document.getElementById("search-results");
    var tree = document.querySelector("#site-nav .site-nav");
    if (!input || !results) return;
    var assetRoot = input.getAttribute("data-asset-root") || "";
    function render(matches) {
        results.innerHTML = "";
        matches.forEach(function (entry) {
            var li = document.createElement("li");
            li.className = "search-result " + entry.status;
            var a = document.createElement("a");
            a.href = assetRoot + entry.path;
            var dot = document.createElement("span");
            dot.className = "status-dot";
            dot.setAttribute("aria-hidden", "true");
            a.appendChild(dot);
            a.appendChild(document.createTextNode(entry.title));
            li.appendChild(a);
            results.appendChild(li);
        });
    }
    function apply() {
        var needle = input.value.trim().toLowerCase();
        var searching = needle.length > 0;
        results.classList.toggle("hidden", !searching);
        if (tree) tree.classList.toggle("hidden", searching);
        if (!searching) { results.innerHTML = ""; return; }
        // Mirrors SearchIndex.search (case-insensitive substring over title + text); the
        // slice is a display cap only. Keep the two in step.
        render(index.filter(function (entry) {
            return (entry.title + " " + entry.text).toLowerCase().indexOf(needle) !== -1;
        }).slice(0, 50));
    }
    input.addEventListener("input", apply);
})();
</script>
{% endmacro %}

{% macro renderNavItem(item) %}
    <li class="nav-item {{ item.type }} {{ item.status }}{{ item.current ? ' current' : '' }}">
        <a href="{{ item.href }}"{{ item.current ? ' aria-current="page"' : '' }}><span class="status-dot" aria-hidden="true"></span>{{ item.label | escape }}</a>
        {%- if item.contents is not empty -%}
            <ul class="nav-children">
            {%- for child in item.contents -%}
                {{ renderNavItem(child) }}
            {%- endfor -%}
            </ul>
        {%- endif -%}
    </li>
{% endmacro %}

{# ----- Self-contained document head: meta + inline stylesheet ----- #}

{% macro head(pageTitle) %}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="tabletest-reporter">
<title>{{ pageTitle | escape }}</title>
<style>
:root {
    --paper: #fbfaf8; --raised: #f2efe9; --ink: #1b1d24; --ink-soft: #5c6270;
    --rule: #e6e2d9; --rule-strong: #cdc8bc;
    --accent: #0e6e6b; --accent-wash: #eaf2f1;
    --pass: #2e7d57; --fail: #be4a3f; --fail-wash: #fbeeec;
    --marker: #b4ac9c; --shade: rgba(27, 29, 36, 0.34);
    --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --font-mono: ui-monospace, "SF Mono", "Cascadia Code", "JetBrains Mono", Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
        --paper: #14161b; --raised: #1b1e25; --ink: #e6e9ef; --ink-soft: #969caa;
        --rule: #272b33; --rule-strong: #3a3f49;
        --accent: #38c6be; --accent-wash: #12201f;
        --pass: #5fbe86; --fail: #e0736a; --fail-wash: #241a1b;
        --marker: #565c67; --shade: rgba(0, 0, 0, 0.6); --shade: rgba(0, 0, 0, 0.6);
    }
}
:root[data-theme="dark"] {
    --paper: #14161b; --raised: #1b1e25; --ink: #e6e9ef; --ink-soft: #969caa;
    --rule: #272b33; --rule-strong: #3a3f49;
    --accent: #38c6be; --accent-wash: #12201f;
    --pass: #5fbe86; --fail: #e0736a; --fail-wash: #241a1b;
    --marker: #565c67;
}
* { box-sizing: border-box; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
body {
    margin: 0; padding: 2.5rem clamp(1rem, 4vw, 3rem);
    font-family: var(--font-sans); font-size: 15px; line-height: 1.55;
    color: var(--ink); background: var(--paper);
    -webkit-font-smoothing: antialiased;
}
main { max-width: 1200px; margin: 0 auto; }
a { color: var(--accent); text-underline-offset: 2px; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }

/* Navigation drawer — kept out of the layout flow so content keeps full width.
   A menu button slides the whole-report nav in from the left over a backdrop. */
.nav-toggle {
    flex: none; width: 2.1rem; height: 2.1rem; border: 1px solid var(--rule-strong);
    border-radius: 8px; background: transparent; color: var(--ink-soft);
    cursor: pointer; font-size: 1.05rem; line-height: 1; transition: color 0.15s, border-color 0.15s;
}
.nav-toggle:hover { color: var(--accent); border-color: var(--accent); }
.nav-backdrop {
    position: fixed; inset: 0; z-index: 40; background: rgba(10, 12, 16, 0.45);
    opacity: 0; visibility: hidden; transition: opacity 0.2s;
}
.nav-backdrop.open { opacity: 1; visibility: visible; }
.sidebar {
    position: fixed; top: 0; left: 0; z-index: 50;
    width: min(21rem, 84vw); height: 100vh; overflow-y: auto;
    padding: 1.5rem 1.25rem; background: var(--raised); border-right: 1px solid var(--rule-strong);
    transform: translateX(-100%); transition: transform 0.22s ease; -webkit-overflow-scrolling: touch;
}
.sidebar.open { transform: none; box-shadow: 0 0 40px rgba(0, 0, 0, 0.25); }
.sidebar-home {
    display: block; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft);
    text-decoration: none; padding-bottom: 0.75rem; margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
}
.sidebar-home:hover, .sidebar-home.current { color: var(--accent); }
.site-nav { font-size: 0.85rem; }
.site-nav .nav-item.current > a { color: var(--accent); font-weight: 700; }

/* Whole-report search — a box atop the drawer whose results replace the tree while typing */
.sidebar-search { margin-bottom: 0.5rem; }
.sidebar-search input[type="search"] {
    width: 100%; font-family: var(--font-mono); font-size: 0.8rem; padding: 0.4rem 0.6rem;
    border: 1px solid var(--rule-strong); border-radius: 6px; background: var(--paper); color: var(--ink);
}
.sidebar-search input[type="search"]::placeholder { color: var(--marker); }
.search-results { list-style: none; margin: 0.25rem 0 0.75rem; padding: 0; font-size: 0.85rem; }
.search-results .search-result { padding: 0.15rem 0; }
.search-results a { display: inline-flex; align-items: baseline; gap: 0.55rem; text-decoration: none; color: var(--ink); }
.search-results a:hover { text-decoration: underline; color: var(--accent); }
.search-results .search-result.passed .status-dot { background: var(--pass); }
.search-results .search-result.failed .status-dot { background: var(--fail); }
.search-results .search-result.neutral .status-dot { background: transparent; border: 1px solid var(--marker); }

/* Breadcrumbs — the ancestor trail; sits in the masthead bar's middle slot */
.breadcrumbs { margin: 0; }
.breadcrumbs ol {
    list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: baseline;
    font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-soft);
}
.breadcrumbs li { display: inline-flex; align-items: baseline; }
.breadcrumbs li + li::before { content: "/"; margin: 0 0.5rem; color: var(--marker); }
.breadcrumbs a { color: var(--ink-soft); text-decoration: none; }
.breadcrumbs a:hover { color: var(--accent); text-decoration: underline; }
.breadcrumbs [aria-current="page"] { color: var(--ink); font-weight: 600; }

/* Masthead — one-line bar (menu | breadcrumb-or-eyebrow | theme) over the title */
.masthead { border-bottom: 1px solid var(--rule-strong); padding-bottom: 1.25rem; margin-bottom: 1.5rem; }
.masthead-top { display: flex; align-items: center; gap: 0.85rem; margin-bottom: 0.35rem; }
.masthead-top .bar-mid { flex: 1; min-width: 0; }
.eyebrow {
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-soft);
    margin: 0;
}
h1 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 650; letter-spacing: -0.02em; margin: 0.4rem 0 0; }
.description { color: var(--ink-soft); margin: 0.75rem 0 0; max-width: 66ch; }
.verdict {
    font-family: var(--font-mono); font-size: 0.9rem; margin: 0.85rem 0 0;
    padding-left: 0.75rem; border-left: 3px solid var(--ink-soft);
}
.verdict .count { font-weight: 700; }
.verdict.pass { color: var(--pass); border-left-color: var(--pass); }
.verdict.fail { color: var(--fail); border-left-color: var(--fail); }

/* Theme toggle */
.theme-toggle {
    flex: none; width: 2.1rem; height: 2.1rem; border: 1px solid var(--rule-strong);
    border-radius: 50%; background: transparent; color: var(--ink-soft);
    cursor: pointer; font-size: 1rem; line-height: 1; transition: color 0.15s, border-color 0.15s;
}
.theme-toggle:hover { color: var(--accent); border-color: var(--accent); }

/* Controls */
.controls { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin: 1.5rem 0 0.75rem; }
.controls input[type="search"] {
    font-family: var(--font-mono); font-size: 0.85rem; padding: 0.4rem 0.7rem;
    border: 1px solid var(--rule-strong); border-radius: 6px;
    background: var(--paper); color: var(--ink); min-width: 14rem;
}
.controls input[type="search"]::placeholder { color: var(--marker); }
.toggle { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; color: var(--ink-soft); user-select: none; cursor: pointer; }
.legend { display: flex; flex-wrap: wrap; gap: 1.1rem; margin-left: auto; font-size: 0.78rem; color: var(--ink-soft); }
.legend span { display: inline-flex; align-items: center; gap: 0.4rem; }
.legend .chip { width: 0.85rem; height: 0.85rem; border-radius: 3px; }
.legend .chip.fail { background: var(--fail); }
.legend .chip.expectation { background: var(--accent-wash); border: 1px solid var(--accent); }

/* Table — ledger: hairline horizontal rules, monospaced data */
.table-wrap {
    overflow-x: auto; border: 1px solid var(--rule); border-radius: 10px;
    scrollbar-width: thin; scrollbar-color: var(--rule-strong) transparent;
}
/* A wide table scrolls inside its own box; say so, or a reader takes the last column for the last */
.table-wrap::-webkit-scrollbar { height: 9px; }
.table-wrap::-webkit-scrollbar-thumb { background: var(--rule-strong); border-radius: 5px; }
.table-wrap::-webkit-scrollbar-track { background: transparent; }
.table-wrap.more-right { box-shadow: inset -26px 0 16px -18px var(--shade); }
.table-wrap.more-left { box-shadow: inset 26px 0 16px -18px var(--shade); }
.table-wrap.more-left.more-right {
    box-shadow: inset -26px 0 16px -18px var(--shade), inset 26px 0 16px -18px var(--shade);
}
table { border-collapse: collapse; width: max-content; min-width: 100%; font-family: var(--font-mono); font-size: 0.85rem; }
th, td { padding: 0.6rem 0.9rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); }
tbody tr:last-child td { border-bottom: none; }
thead th {
    position: sticky; top: 0; z-index: 2; background: var(--raised);
    border-bottom: 1px solid var(--rule-strong);
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-soft);
    white-space: nowrap;
}
tbody tr:hover td { background: var(--raised); }
/* Freeze the scenario column (and its header corner) only when the table has one */
.anchored thead th:first-child { position: sticky; left: 0; z-index: 3; }
.anchored tbody td:first-child {
    position: sticky; left: 0; z-index: 1; background: var(--paper);
    box-shadow: 1px 0 0 var(--rule);
}
.anchored tbody tr:hover td:first-child { background: var(--raised); }

/* Roles: expectation = the outcome (accent wash); scenario = the case label */
td.scenario, th.scenario { font-weight: 600; color: var(--ink); }
td.expectation, thead th.expectation { background: var(--accent-wash); }
thead th.expectation { color: var(--accent); }

/* Status: colour marks failure only; success stays calm */
tr.failed-row td:first-child { box-shadow: inset 3px 0 0 var(--fail); }
.anchored tr.failed-row td:first-child { box-shadow: inset 3px 0 0 var(--fail), 1px 0 0 var(--rule); }
tr.failed-row:hover td { background: var(--fail-wash); }
td.failed { color: var(--fail); background: var(--fail-wash); }
td.failed.expectation { background: var(--fail-wash); }

/* Values */
.empty { color: var(--marker); }
.empty-string { color: var(--ink-soft); }
.literal { white-space: pre-wrap; }
/* Whitespace-significant literals get CSS-drawn per-character markers on their
   significant runs; the real characters stay in the DOM for copy and search */
.literal.ws { font-family: var(--font-mono); font-size: 0.85em; }
.literal.ws .sp {
    background: radial-gradient(circle, var(--marker) 1px, transparent 1.5px)
        left center / 1ch 1em repeat-x;
}
.literal.ws .tab { position: relative; }
.literal.ws .tab::before {
    content: "\2192"; position: absolute; left: 0.1ch; color: var(--marker);
}
.coll { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.15rem; }
.coll.list > li, .coll.set > li { position: relative; padding-left: 1.15rem; }
.coll.list > li::before { content: "\2013"; position: absolute; left: 0; color: var(--accent); }
.coll.set > li::before { content: "\25E6"; position: absolute; left: 0.1rem; color: var(--marker); }
.coll.map { grid-template-columns: auto 1fr; gap: 0.15rem 0.7rem; }
.coll.map > dt { color: var(--ink-soft); margin: 0; }
.coll.map > dt::after { content: ":"; color: var(--marker); }
.coll.map > dd { margin: 0; }

/* A `lines` column holds the lines of one block of text, so its cells stack as written:
   no list markers, no gaps, monospaced, and whitespace preserved rather than collapsed.
   Body cells only — the header carries the role so a stylesheet can select the column,
   but it holds the column's name rather than source text. */
td.cell.lines .coll.list { gap: 0; }
td.cell.lines .coll.list > li { padding-left: 0; }
td.cell.lines .coll.list > li::before { content: none; }
td.cell.lines .literal { font-family: var(--font-mono); font-size: 0.85em; white-space: pre; }
/* The layout already shows alignment padding, so its markers are noise here; a run at the end
   of a line is the one it cannot show, and keeps its marker. */
td.cell.lines .literal.ws .sp:not(.trailing) { background: none; }

/* Failures — reads like a test log */
.failures { margin-top: 2rem; }
.failures h2 { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fail); margin: 0 0 0.75rem; }
.failures details {
    border: 1px solid var(--rule); border-left: 3px solid var(--fail); border-radius: 8px;
    margin: 0.6rem 0; padding: 0.6rem 0.9rem; background: var(--raised);
}
.failures summary { cursor: pointer; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600; color: var(--ink); }
.failures pre {
    overflow-x: auto; margin: 0.6rem 0 0; padding: 0.75rem;
    font-family: var(--font-mono); font-size: 0.82rem; color: var(--fail);
    background: var(--paper); border-radius: 6px;
}

/* Single-file report: each page inlined as an anchored section */
.report-section { margin-top: 2.75rem; scroll-margin-top: 1rem; }
.report-section .section-title {
    font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 650; letter-spacing: -0.01em;
    margin: 0 0 0.6rem; padding-top: 0.75rem; border-top: 1px solid var(--rule);
}
.report-section.index .section-title { color: var(--accent); border-top-color: var(--rule-strong); }
.report-section .description { margin: 0.5rem 0 1rem; }
.report-section .verdict { margin: 0.5rem 0 0.85rem; }
.report-section .failures { margin-top: 1.25rem; }

/* Index tree — a table of contents for the spec suite */
.nav-tree, .nav-children { list-style: none; margin: 0; padding: 0; }
.nav-tree { margin-top: 0.5rem; }
.nav-children { margin-left: 0.6rem; padding-left: 1rem; border-left: 1px solid var(--rule); }
.nav-item { padding: 0.15rem 0; }
.nav-item > a { display: inline-flex; align-items: baseline; gap: 0.55rem; text-decoration: none; padding: 0.15rem 0; }
.nav-item > a:hover { text-decoration: underline; }
.nav-item > a::before { font-family: var(--font-mono); color: var(--marker); }
.nav-item.index > a { font-weight: 650; color: var(--ink); }
.nav-item.index > a::before { content: "\25C6"; color: var(--accent); font-size: 0.7em; }
.nav-item.table > a::before { content: "\2013"; }
/* Status dot: colour marks failure; passing is calm, neutral (no run) is muted */
.status-dot { flex: none; align-self: center; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--marker); }
.nav-item.passed > a .status-dot { background: var(--pass); }
.nav-item.failed > a .status-dot { background: var(--fail); }
.nav-item.neutral > a .status-dot { background: transparent; border: 1px solid var(--marker); }

/* Footer */
.doc-footer {
    margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--rule);
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.04em; color: var(--marker);
}
.hidden { display: none !important; }

@media print {
    body { padding: 0; }
    .sidebar, .nav-backdrop, .nav-toggle, .controls, .theme-toggle { display: none; }
    .table-wrap { overflow: visible; border: none; }
    thead th, tbody td:first-child, tbody th:first-child { position: static; box-shadow: none; }
    .failures details { break-inside: avoid; }
}
</style>
{% endmacro %}

{# ----- Theme toggle button + script (shared by table and index pages) ----- #}

{% macro themeToggle() %}
<button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle light or dark theme" title="Toggle theme">&#9680;</button>
{% endmacro %}

{% macro tableScrollScript() %}
<script>
(function () {
    function mark(wrap) {
        var slack = wrap.scrollWidth - wrap.clientWidth;
        wrap.classList.toggle("more-left", wrap.scrollLeft > 1);
        wrap.classList.toggle("more-right", slack > 1 && wrap.scrollLeft < slack - 1);
    }
    var wraps = document.querySelectorAll(".table-wrap");
    for (var i = 0; i < wraps.length; i++) {
        (function (wrap) {
            mark(wrap);
            wrap.addEventListener("scroll", function () { mark(wrap); }, { passive: true });
        })(wraps[i]);
    }
    window.addEventListener("resize", function () {
        for (var j = 0; j < wraps.length; j++) mark(wraps[j]);
    }, { passive: true });
})();
</script>
{% endmacro %}

{% macro themeScript() %}
<script>
(function () {
    var root = document.documentElement;
    var stored = null;
    try { stored = localStorage.getItem("tabletest-theme"); } catch (e) {}
    if (stored) root.setAttribute("data-theme", stored);
    var toggle = document.getElementById("theme-toggle");
    if (toggle) toggle.addEventListener("click", function () {
        var dark = root.getAttribute("data-theme") === "dark"
            || (!root.getAttribute("data-theme") && matchMedia("(prefers-color-scheme: dark)").matches);
        var next = dark ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("tabletest-theme", next); } catch (e) {}
    });
})();
</script>
{% endmacro %}
