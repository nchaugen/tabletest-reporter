{% import "macros.html.peb" %}
<!DOCTYPE html>
<html lang="en">
<head>
{{ head(title ? title : name) }}
</head>
<body>
{{ renderSidebar(nav, assetRoot) }}
<main>
    <header class="masthead">
        {{ mastheadBar(breadcrumbs, nav, "Specification index") }}
        <h1>{{ (title ? title : name) | escape }}</h1>
        {%- if status.total > 0 -%}
            {%- if status.broken > 0 -%}
                <p class="verdict fail"><span class="count">{{ status.broken }}</span> of {{ status.total }} scenario{{ status.total == 1 ? '' : 's' }} broken</p>
            {%- else -%}
                <p class="verdict pass">All <span class="count">{{ status.total }}</span> scenario{{ status.total == 1 ? '' : 's' }} passing</p>
            {%- endif -%}
        {%- endif -%}
        {% if description %}<p class="description">{{ description | escape }}</p>{% endif %}
    </header>

    <ul class="nav-tree">
    {%- for child in contents -%}
        {{ renderIndexItem(child) }}
    {%- endfor -%}
    </ul>

    <footer class="doc-footer">Generated by tabletest-reporter</footer>
</main>
{{ themeScript() }}
{{ navScript() }}
<script src="{{ assetRoot }}tabletest-search-index.js"></script>
{{ searchScript() }}
</body>
</html>
