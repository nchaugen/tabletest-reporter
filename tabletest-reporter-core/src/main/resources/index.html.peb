{% import "macros.html.peb" %}
<!DOCTYPE html>
<html lang="en">
<head>
{{ head(title ? title : name) }}
</head>
<body>
<main>
    <header class="masthead">
        <div class="masthead-top">
            <p class="eyebrow">Specification index</p>
            {{ themeToggle() }}
        </div>
        <h1>{{ (title ? title : name) | escape }}</h1>
        {% if description %}<p class="description">{{ description | escape }}</p>{% endif %}
    </header>

    <ul class="nav-tree">
    {%- for child in contents -%}
        {{ renderIndexItem(child) }}
    {%- endfor -%}
    </ul>

    <footer class="doc-footer">Generated by tabletest-reporter</footer>
</main>
{{ themeScript() }}
</body>
</html>
