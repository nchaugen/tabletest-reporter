{% import "macros.html.peb" %}
<!DOCTYPE html>
<html lang="en">
<head>
{{ head(title ? title : name) }}
{# Style a column role of your own here; the built-in stylesheet above stays in place. #}
<style>{% block extra_stylesheet %}{% endblock %}</style>
</head>
<body>
{{ renderSidebar(nav, assetRoot) }}
<main>
    <header class="masthead">
        {{ mastheadBar(breadcrumbs, nav, "Specification index") }}
        <h1>{{ (title ? title : name) | escape }}</h1>
        {%- if status.total > 0 -%}
            {%- if status.broken > 0 -%}
                <p class="verdict fail"><span class="count">{{ status.broken }}</span> of {{ status.total }} scenario{{ status.total == 1 ? '' : 's' }} broken</p>
            {%- else -%}
                <p class="verdict pass">All <span class="count">{{ status.total }}</span> scenario{{ status.total == 1 ? '' : 's' }} hold</p>
            {%- endif -%}
        {%- endif -%}
        {% for paragraph in description | paragraphs %}<p class="description">{{ paragraph | escape }}</p>{% endfor %}
    </header>

    <ul class="nav-tree">
    {%- for child in contents -%}
        {{ renderIndexItem(child) }}
    {%- endfor -%}
    </ul>

    {% block footer %}{{ docFooter(generatedAt, site) }}{% endblock %}
</main>
{{ themeScript() }}
{{ navScript() }}
{{ navKeysScript() }}
<script src="{{ assetRoot }}tabletest-search-index.js"></script>
{{ searchScript() }}
</body>
</html>
